{
  "productName": "Watiqa-Link",
  "version": "0.1.0",
  "identifier": "ma.bouskoura.watiqa",
  "build": {
    "beforeDevCommand": "bun dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Watiqa-Link",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "omnizya",
    "category": "Office",
    "copyright": "© 2026 omnizya",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": [
          "ar-SA",
          "fr-FR",
          "en-US"
        ],
        "template": null
      },
      "nsis": {
        "languages": [
          "Arabic",
          "French",
          "English"
        ],
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "opener": {},
    "shell": {}
  }
}